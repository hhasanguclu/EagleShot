<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EagleShot.Views.SettingsView">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,32,36,32" MaxWidth="820" HorizontalAlignment="Left">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock Classes="h1" Text="Settings"/>
                    <TextBlock Classes="sub" Margin="0,4,0,0" Text="Changes are saved automatically."/>
                </StackPanel>
                <TextBlock Grid.Column="1" Name="SavedText" Classes="muted" Text="✓ Saved" Opacity="0" VerticalAlignment="Bottom" Foreground="{StaticResource SuccessBrush}"/>
            </Grid>

            <!-- General -->
            <Border Classes="card">
                <StackPanel Spacing="6">
                    <TextBlock Classes="h2" Text="General"/>
                    <CheckBox Name="StartWithSystem" Content="Start EagleShot when I sign in"/>
                    <CheckBox Name="ShowMainOnStartup" Content="Open this window on startup (otherwise start in the tray)"/>
                    <CheckBox Name="ShowSplash" Content="Show splash screen"/>
                </StackPanel>
            </Border>

            <!-- Capture -->
            <Border Classes="card">
                <StackPanel Spacing="6">
                    <TextBlock Classes="h2" Text="Capture"/>
                    <CheckBox Name="ShowMagnifier" Content="Show magnifier with pixel color while selecting"/>
                    <CheckBox Name="ShowCrosshair" Content="Show crosshair lines"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Classes="label" Text="Delayed capture countdown"/>
                        <NumericUpDown Name="DelaySeconds" Minimum="1" Maximum="60" Increment="1" FormatString="0" Width="130"/>
                        <TextBlock Classes="muted" Text="seconds" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- After capture -->
            <Border Classes="card">
                <StackPanel Spacing="6">
                    <TextBlock Classes="h2" Text="After capture tasks"/>
                    <TextBlock Classes="muted" Text="Run when you confirm in the editor (✓ / Enter / double-click) and for full-screen, monitor and repeat captures. Toolbar buttons like Copy or Save run only their own task."/>
                    <CheckBox Name="AfterCopy" Content="Copy image to clipboard"/>
                    <CheckBox Name="AfterSave" Content="Save image to the screenshot folder"/>
                    <CheckBox Name="AfterUpload" Content="Upload image"/>
                    <CheckBox Name="AfterCopyUrl" Content="Copy the link after uploading (replaces the image on the clipboard)" Margin="26,0,0,0"/>
                    <CheckBox Name="AfterPin" Content="Pin image to screen"/>
                    <CheckBox Name="AfterNotify" Content="Show a notification"/>
                </StackPanel>
            </Border>

            <!-- Output -->
            <Border Classes="card">
                <StackPanel Spacing="6">
                    <TextBlock Classes="h2" Text="Files"/>
                    <Grid ColumnDefinitions="150,*,Auto,Auto" Classes="form">
                        <TextBlock Classes="label" Text="Screenshot folder"/>
                        <TextBox Grid.Column="1" Name="SaveFolder"/>
                        <Button Grid.Column="2" Classes="ghost" Content="Browse…" Click="OnBrowseFolder"/>
                        <Button Grid.Column="3" Classes="ghost" Content="Open" Click="OnOpenFolder"/>
                    </Grid>
                    <Grid ColumnDefinitions="150,*" Classes="form" RowDefinitions="Auto,Auto,Auto">
                        <TextBlock Classes="label" Text="File name pattern"/>
                        <TextBox Grid.Column="1" Name="FileNamePattern" FontFamily="Consolas, Menlo, monospace"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Name="PatternPreview" Classes="sub" Margin="0,6,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Name="PatternHelp" Classes="muted" Margin="0,4,0,0"/>
                    </Grid>
                    <Grid ColumnDefinitions="150,Auto,Auto,*,Auto" Classes="form">
                        <TextBlock Classes="label" Text="Image format"/>
                        <ComboBox Grid.Column="1" Name="ImageFormat" Width="120">
                            <ComboBoxItem Content="PNG"/>
                            <ComboBoxItem Content="JPEG"/>
                            <ComboBoxItem Content="WebP"/>
                        </ComboBox>
                        <TextBlock Grid.Column="2" Classes="label" Text="Quality" Margin="16,0,0,0" Name="QualityLabel"/>
                        <Slider Grid.Column="3" Name="JpegQuality" Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"/>
                        <TextBlock Grid.Column="4" Name="QualityValue" Classes="label" MinWidth="34"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Upload -->
            <Border Classes="card">
                <StackPanel Spacing="6">
                    <TextBlock Classes="h2" Text="Upload"/>
                    <Grid ColumnDefinitions="150,*" Classes="form">
                        <TextBlock Classes="label" Text="Destination"/>
                        <ComboBox Grid.Column="1" Name="Uploader" Width="220">
                            <ComboBoxItem Content="None"/>
                            <ComboBoxItem Content="Imgur"/>
                            <ComboBoxItem Content="Custom uploader (HTTP)"/>
                        </ComboBox>
                    </Grid>

                    <StackPanel Name="ImgurPanel" Spacing="8">
                        <Grid ColumnDefinitions="150,*" Classes="form">
                            <TextBlock Classes="label" Text="Client ID"/>
                            <TextBox Grid.Column="1" Name="ImgurClientId" Watermark="Imgur application Client ID"/>
                        </Grid>
                        <TextBlock Classes="muted" Margin="158,0,0,0" Text="Register a free application at api.imgur.com/oauth2/addclient (choose “anonymous usage”) and paste its Client ID."/>
                    </StackPanel>

                    <StackPanel Name="CustomPanel" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="158,0,0,0">
                            <Button Classes="ghost" Content="Import ShareX uploader (.sxcu)…" Click="OnImportSxcu"/>
                            <TextBlock Name="CustomName" Classes="muted" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="150,Auto,Auto,Auto" Classes="form">
                            <TextBlock Classes="label" Text="Method / body"/>
                            <ComboBox Grid.Column="1" Name="CustomMethod" Width="110">
                                <ComboBoxItem Content="POST"/>
                                <ComboBoxItem Content="PUT"/>
                                <ComboBoxItem Content="PATCH"/>
                            </ComboBox>
                            <ComboBox Grid.Column="2" Name="CustomBody" Width="200">
                                <ComboBoxItem Content="MultipartFormData"/>
                                <ComboBoxItem Content="Binary"/>
                            </ComboBox>
                        </Grid>
                        <Grid ColumnDefinitions="150,*" Classes="form">
                            <TextBlock Classes="label" Text="Request URL"/>
                            <TextBox Grid.Column="1" Name="CustomUrl" Watermark="https://example.com/upload"/>
                        </Grid>
                        <Grid ColumnDefinitions="150,*" Classes="form">
                            <TextBlock Classes="label" Text="File form field"/>
                            <TextBox Grid.Column="1" Name="CustomField" Watermark="file"/>
                        </Grid>
                        <Grid ColumnDefinitions="150,*" Classes="form">
                            <TextBlock Classes="label" Text="Headers" VerticalAlignment="Top" Margin="0,6,0,0"/>
                            <TextBox Grid.Column="1" Name="CustomHeaders" AcceptsReturn="True" Height="70" TextWrapping="Wrap"
                                     Watermark="Authorization: Bearer xxx  (one per line)"/>
                        </Grid>
                        <Grid ColumnDefinitions="150,*" Classes="form">
                            <TextBlock Classes="label" Text="URL from response"/>
                            <TextBox Grid.Column="1" Name="CustomJsonPath" Watermark="data.url  ·  {json:files[0].url}  ·  {regex:https?://\S+}  ·  empty = whole body"/>
                        </Grid>
                        <Grid ColumnDefinitions="150,*" Classes="form">
                            <TextBlock Classes="label" Text="Form arguments" VerticalAlignment="Top" Margin="0,6,0,0"/>
                            <TextBox Grid.Column="1" Name="CustomArguments" AcceptsReturn="True" Height="54" TextWrapping="Wrap"
                                     Watermark="key: value  (one per line, multipart only)"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="158,0,0,0" Name="TestUploadRow">
                        <Button Classes="ghost" Content="Test upload" Click="OnTestUpload"/>
                        <TextBlock Name="TestUploadResult" Classes="muted" VerticalAlignment="Center" MaxWidth="460"/>
                    </StackPanel>
                    <CheckBox Name="ShortenUrls" Content="Shorten uploaded links with is.gd"/>
                </StackPanel>
            </Border>

            <!-- Image effects -->
            <Border Classes="card">
                <Grid ColumnDefinitions="*,220">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="h2" Text="Image effects"/>
                        <TextBlock Classes="muted" Text="Applied to screenshots before they are saved, copied or uploaded. Transparent backgrounds turn black in JPEG."/>
                        <CheckBox Name="EffectsEnabled" Content="Enable image effects"/>
                        <Grid ColumnDefinitions="150,Auto,Auto,Auto" Classes="form">
                            <TextBlock Classes="label" Text="Padding / background"/>
                            <NumericUpDown Grid.Column="1" Name="EffPadding" Minimum="0" Maximum="200" FormatString="0" Width="120"/>
                            <TextBox Grid.Column="2" Name="EffBackground" Width="120" Watermark="#00000000"/>
                        </Grid>
                        <Grid ColumnDefinitions="150,Auto" Classes="form">
                            <TextBlock Classes="label" Text="Rounded corners"/>
                            <NumericUpDown Grid.Column="1" Name="EffRadius" Minimum="0" Maximum="100" FormatString="0" Width="120"/>
                        </Grid>
                        <Grid ColumnDefinitions="150,Auto,Auto" Classes="form">
                            <CheckBox Name="EffShadow" Content="Drop shadow"/>
                            <NumericUpDown Grid.Column="1" Name="EffShadowSize" Minimum="2" Maximum="80" FormatString="0" Width="120"/>
                        </Grid>
                        <Grid ColumnDefinitions="150,Auto,Auto" Classes="form">
                            <TextBlock Classes="label" Text="Border width / color"/>
                            <NumericUpDown Grid.Column="1" Name="EffBorder" Minimum="0" Maximum="40" FormatString="0" Width="120"/>
                            <TextBox Grid.Column="2" Name="EffBorderColor" Width="120" Watermark="#4C8DFF"/>
                        </Grid>
                        <Grid ColumnDefinitions="150,*" Classes="form">
                            <TextBlock Classes="label" Text="Watermark text"/>
                            <TextBox Grid.Column="1" Name="EffWatermark" Watermark="e.g. © My Company"/>
                        </Grid>
                        <Grid ColumnDefinitions="150,Auto,Auto,Auto" Classes="form">
                            <TextBlock Classes="label" Text="Position / size / opacity"/>
                            <ComboBox Grid.Column="1" Name="EffWatermarkPos" Width="140">
                                <ComboBoxItem Content="Top left"/>
                                <ComboBoxItem Content="Top right"/>
                                <ComboBoxItem Content="Bottom left"/>
                                <ComboBoxItem Content="Bottom right"/>
                                <ComboBoxItem Content="Center"/>
                            </ComboBox>
                            <NumericUpDown Grid.Column="2" Name="EffWatermarkSize" Minimum="8" Maximum="120" FormatString="0" Width="110"/>
                            <NumericUpDown Grid.Column="3" Name="EffWatermarkOpacity" Minimum="5" Maximum="100" FormatString="0" Width="110"/>
                        </Grid>
                    </StackPanel>
                    <Border Grid.Column="1" Margin="12,30,0,0" CornerRadius="10" Background="#E4E6EE" VerticalAlignment="Top" Height="200">
                        <Image Name="EffectsPreview" Stretch="Uniform" Margin="8"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Recording -->
            <Border Classes="card">
                <StackPanel Spacing="6">
                    <TextBlock Classes="h2" Text="Screen recording"/>
                    <TextBlock Classes="muted" Name="FfmpegStatus"/>
                    <Grid ColumnDefinitions="150,*,Auto" Classes="form">
                        <TextBlock Classes="label" Text="ffmpeg path"/>
                        <TextBox Grid.Column="1" Name="FfmpegPath" Watermark="Automatic (PATH, Homebrew, winget…)"/>
                        <Button Grid.Column="2" Classes="ghost" Content="Browse…" Tag="FfmpegPath" Click="OnBrowseTool"/>
                    </Grid>
                    <Grid ColumnDefinitions="150,Auto,Auto,Auto,Auto" Classes="form">
                        <TextBlock Classes="label" Text="Video / GIF FPS"/>
                        <NumericUpDown Grid.Column="1" Name="VideoFps" Minimum="5" Maximum="60" FormatString="0" Width="110"/>
                        <NumericUpDown Grid.Column="2" Name="GifFps" Minimum="5" Maximum="30" FormatString="0" Width="110"/>
                        <TextBlock Grid.Column="3" Classes="label" Text="GIF max width"/>
                        <NumericUpDown Grid.Column="4" Name="GifMaxWidth" Minimum="160" Maximum="3840" Increment="40" FormatString="0" Width="120"/>
                    </Grid>
                    <Grid ColumnDefinitions="150,Auto" Classes="form">
                        <TextBlock Classes="label" Text="Countdown (seconds)"/>
                        <NumericUpDown Grid.Column="1" Name="RecordCountdown" Minimum="0" Maximum="10" FormatString="0" Width="110"/>
                    </Grid>
                    <CheckBox Name="RecordCursor" Content="Record the mouse cursor"/>
                    <CheckBox Name="RecordStartButton" Content="Show a Start button after selecting the area (otherwise start right away)"/>
                </StackPanel>
            </Border>

            <!-- Tools -->
            <Border Classes="card">
                <StackPanel Spacing="6">
                    <TextBlock Classes="h2" Text="Tools"/>
                    <TextBlock Classes="muted" Name="TesseractStatus"/>
                    <Grid ColumnDefinitions="150,*,Auto" Classes="form">
                        <TextBlock Classes="label" Text="Tesseract path"/>
                        <TextBox Grid.Column="1" Name="TesseractPath" Watermark="Automatic"/>
                        <Button Grid.Column="2" Classes="ghost" Content="Browse…" Tag="TesseractPath" Click="OnBrowseTool"/>
                    </Grid>
                    <Grid ColumnDefinitions="150,*" Classes="form">
                        <TextBlock Classes="label" Text="OCR languages"/>
                        <TextBox Grid.Column="1" Name="OcrLanguages" Watermark="Automatic (eng+tur when installed), e.g. eng+deu"/>
                    </Grid>
                    <Grid ColumnDefinitions="150,Auto,Auto,Auto" Classes="form">
                        <TextBlock Classes="label" Text="Scrolling: max / delay ms"/>
                        <NumericUpDown Grid.Column="1" Name="ScrollMax" Minimum="1" Maximum="200" FormatString="0" Width="110"/>
                        <NumericUpDown Grid.Column="2" Name="ScrollDelay" Minimum="100" Maximum="3000" Increment="50" FormatString="0" Width="120"/>
                    </Grid>
                    <Grid ColumnDefinitions="150,Auto,Auto" Classes="form">
                        <TextBlock Classes="label" Text="Auto capture every (s)"/>
                        <NumericUpDown Grid.Column="1" Name="AutoInterval" Minimum="2" Maximum="86400" FormatString="0" Width="120"/>
                        <ComboBox Grid.Column="2" Name="AutoMode" Width="160">
                            <ComboBoxItem Content="Full screen"/>
                            <ComboBoxItem Content="Last region"/>
                            <ComboBoxItem Content="Active monitor"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Hotkeys -->
            <Border Classes="card">
                <StackPanel Spacing="6">
                    <TextBlock Classes="h2" Text="Hotkeys"/>
                    <TextBlock Classes="muted" Text="Click a box and press the new key combination. Esc cancels, the × button clears."/>
                    <CheckBox Name="TakeOverPrintScreen" Content="Windows: use the PrintScreen key for EagleShot instead of the Snipping Tool"/>
                    <Grid Name="HotkeyGrid" ColumnDefinitions="200,Auto,Auto"/>
                    <TextBlock Classes="muted" Name="HotkeyStatus"/>
                    <TextBlock Classes="muted" TextWrapping="Wrap"
                               Text="Command line (handy on Wayland or for desktop shortcuts): eagleshot --region · --fullscreen · --monitor · --delay · --repeat · --color · --show"/>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Classes="h2" Text="About"/>
                    <TextBlock Classes="sub" Name="AboutText"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="ghost" Content="Open settings folder" Click="OnOpenConfigFolder"/>
                        <Button Classes="ghost" Content="GitHub" Click="OnOpenGitHub"/>
                        <Button Classes="ghost" Content="Reset to defaults" Click="OnResetDefaults"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
