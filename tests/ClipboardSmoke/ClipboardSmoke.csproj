<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows-only check that EagleShot's clipboard output can be read back by other apps. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\EagleShot.csproj" />
  </ItemGroup>
</Project>
