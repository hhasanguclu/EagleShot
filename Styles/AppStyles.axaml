<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <!-- Palette -->
        <Color x:Key="AccentColor">#4C8DFF</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="#4C8DFF"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#6AA0FF"/>
        <SolidColorBrush x:Key="WindowBrush" Color="#0F1015"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#14151C"/>
        <SolidColorBrush x:Key="CardBrush" Color="#1A1B23"/>
        <SolidColorBrush x:Key="CardHoverBrush" Color="#22232E"/>
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="#2A2B36"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#ECEDF2"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9A9CAE"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#6B6D80"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#FF5C5C"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#3DD68C"/>
        <SolidColorBrush x:Key="ToolbarBrush" Color="#F0141520"/>

        <!-- Icons (Material Design, 24x24) -->
        <StreamGeometry x:Key="IconSelect">M7,2 L19,13.2 L13.2,13.7 L16.5,21 L14.3,22 L11.1,14.6 L7,18.5 Z</StreamGeometry>
