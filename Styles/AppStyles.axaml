    </Styles.Resources>

    <!-- ═══════════════ Overlay editor toolbar ═══════════════ -->

    <Style Selector="Button.tool-btn, ToggleButton.tool-btn">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="Button.tool-btn PathIcon, ToggleButton.tool-btn PathIcon">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
    </Style>
    <!-- The active drawing tool looks pressed in -->
    <Style Selector="Button.tool-btn.selected /template/ Border#BevelOuter">
        <Setter Property="BorderBrush" Value="{DynamicResource ClassicLight}"/>
        <Setter Property="Background" Value="#E3E3E3"/>
    </Style>
    <Style Selector="Button.tool-btn.selected /template/ Border#BevelOuterLight">
        <Setter Property="BorderBrush" Value="{DynamicResource ClassicShadow}"/>
    </Style>
    <Style Selector="Button.tool-btn:disabled PathIcon">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>
    <Style Selector="Button.tool-btn.primary PathIcon">
        <Setter Property="Foreground" Value="#007000"/>
    </Style>
    <Style Selector="Button.tool-btn.danger PathIcon">
        <Setter Property="Foreground" Value="#C00000"/>
    </Style>

    <!-- Etched vertical divider between toolbar groups -->
    <Style Selector="Border.separator">
        <Setter Property="Width" Value="2"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Background" Value="{DynamicResource ClassicShadow}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ClassicLight}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.color-swatch">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="1"/>
    </Style>
    <Style Selector="Button.color-swatch.selected /template/ Border#DefaultRing">
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <Style Selector="Button.width-btn">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="Button.width-btn.selected /template/ Border#BevelOuter">
        <Setter Property="BorderBrush" Value="{DynamicResource ClassicLight}"/>
        <Setter Property="Background" Value="#E3E3E3"/>
    </Style>
    <Style Selector="Button.width-btn.selected /template/ Border#BevelOuterLight">
        <Setter Property="BorderBrush" Value="{DynamicResource ClassicDark}"/>
    </Style>

    <Style Selector="Button.text-size-btn">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- ═══════════════ Main window ═══════════════ -->

    <!-- Raised panel (toolbar, tab page) -->
    <Style Selector="Border.raised">
        <Setter Property="Background" Value="{DynamicResource ClassicFace}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ClassicShadow}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="BoxShadow" Value="inset 1 1 0 0 #FFFFFF"/>
    </Style>
    <!-- Sunken panel (status bar fields, list areas) -->
    <Style Selector="Border.sunken">
        <Setter Property="BorderBrush" Value="{DynamicResource ClassicShadow}"/>
        <Setter Property="BorderThickness" Value="1,1,0,0"/>
        <Setter Property="BoxShadow" Value="inset -1 -1 0 0 #FFFFFF"/>
        <Setter Property="Padding" Value="4,1"/>
    </Style>
    <Style Selector="Border.sunken-deep">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ClassicShadow}"/>
        <Setter Property="BorderThickness" Value="1,1,0,0"/>
        <Setter Property="BoxShadow" Value="inset 1 1 0 0 #404040, inset -1 -1 0 0 #DFDFDF"/>
        <Setter Property="Padding" Value="2"/>
    </Style>

    <!-- Tabs -->
    <Style Selector="ToggleButton.nav">
        <Setter Property="Padding" Value="10,2"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Height" Value="21"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="TabOuter" Background="{DynamicResource ClassicFace}" BorderBrush="{DynamicResource ClassicDark}" BorderThickness="0,0,1,0">
                    <Border BorderBrush="{DynamicResource ClassicLight}" BorderThickness="1,1,0,0">
                        <Border BorderBrush="{DynamicResource ClassicShadow}" BorderThickness="0,0,1,0">
                            <ContentPresenter Name="TabContent"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              Foreground="Black"
                                              VerticalContentAlignment="Center"/>
                        </Border>
                    </Border>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <!-- The selected tab is taller and joins the page below it -->
    <Style Selector="ToggleButton.nav:checked">
        <Setter Property="Height" Value="24"/>
        <Setter Property="Margin" Value="-2,0,-2,-1"/>
        <Setter Property="Padding" Value="12,2,12,4"/>
        <Setter Property="ZIndex" Value="1"/>
    </Style>


    <!-- Group box: etched frame with a caption on its top edge -->
    <Style Selector="HeaderedContentControl.group">
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="7,*">
                    <Border Grid.RowSpan="2" Grid.Row="1" Margin="0,0,1,1"
                            BorderBrush="{DynamicResource ClassicShadow}" BorderThickness="1"/>
                    <Border Grid.RowSpan="2" Grid.Row="1" Margin="1,1,0,0"
                            BorderBrush="{DynamicResource ClassicLight}" BorderThickness="1"/>
                    <Border Grid.RowSpan="2" Margin="8,0,0,0" Padding="2,0" Background="{DynamicResource ClassicFace}"
                            HorizontalAlignment="Left" VerticalAlignment="Top">
                        <ContentPresenter Content="{TemplateBinding Header}"/>
                    </Border>
                    <ContentPresenter Grid.Row="1" Margin="10,12,10,10"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"/>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Capture mode buttons on the home page -->
    <Style Selector="Button.capture-card">
        <Setter Property="Width" Value="224"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.tool-card">
        <Setter Property="Width" Value="224"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.tool-card.active">
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="Button.tool-card.active /template/ Border#BevelOuter">
        <Setter Property="Background" Value="#E3E3E3"/>
    </Style>

    <Style Selector="PathIcon.card-icon">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Margin" Value="2,0,8,0"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.icon-badge">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Margin" Value="0,0,0,0"/>
    </Style>
    <Style Selector="Border.icon-badge PathIcon">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    </Style>

    <!-- Hotkey text next to a capture mode -->
    <Style Selector="Border.kbd TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="#404040"/>
    </Style>

    <!-- Settings sections: a group box drawn on a plain border -->
    <Style Selector="Border.card">
        <Setter Property="BorderBrush" Value="{DynamicResource ClassicShadow}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BoxShadow" Value="inset 1 1 0 0 #FFFFFF, 1 1 0 0 #FFFFFF"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="0,0,1,10"/>
    </Style>

    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="Black"/>
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="Black"/>
    </Style>
    <Style Selector="TextBlock.sub">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#404040"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.ghost, Button.accent">
        <Setter Property="MinWidth" Value="75"/>
    </Style>
    <Style Selector="Button.ghost PathIcon, Button.accent PathIcon">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
    </Style>

    <Style Selector="Button.icon-btn">
        <Setter Property="Width" Value="23"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="Button.icon-btn PathIcon">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
    </Style>
    <Style Selector="Button.icon-btn.danger PathIcon">
        <Setter Property="Foreground" Value="#C00000"/>
    </Style>

    <!-- History thumbnail card: a sunken picture frame with the name below -->
    <Style Selector="Border.history-card">
        <Setter Property="Width" Value="200"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="Background" Value="{DynamicResource ClassicFace}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ClassicDark}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="BoxShadow" Value="inset 1 1 0 0 #FFFFFF, inset -1 -1 0 0 #808080"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style Selector="Border.history-card StackPanel.card-actions">
        <Setter Property="Opacity" Value="0"/>
    </Style>
    <Style Selector="Border.history-card:pointerover StackPanel.card-actions">
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <Style Selector="Grid.form > Control">
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <Style Selector="Button.hotkey-box">
        <Setter Property="MinWidth" Value="170"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="FontFamily" Value="Courier New, Consolas, DejaVu Sans Mono, monospace"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Frame" Classes="sunken-deep" Background="{TemplateBinding Background}">
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                      Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.hotkey-box.recording">
        <Setter Property="Background" Value="{DynamicResource ClassicHighlight}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

</Styles>
