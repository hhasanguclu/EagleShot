<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <!-- Palette (classic Windows) -->
        <Color x:Key="AccentColor">#000080</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="#000080"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1084D0"/>
        <SolidColorBrush x:Key="WindowBrush" Color="#C0C0C0"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#C0C0C0"/>
        <SolidColorBrush x:Key="CardBrush" Color="#C0C0C0"/>
        <SolidColorBrush x:Key="CardHoverBrush" Color="#C0C0C0"/>
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="#808080"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#000000"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#000000"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#404040"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#C00000"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#007000"/>
        <SolidColorBrush x:Key="ToolbarBrush" Color="#C0C0C0"/>

